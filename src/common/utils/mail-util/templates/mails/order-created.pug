doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Order Confirmation

    style.
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #ffffff;
        font-family: Google Sans, Roboto, Arial, sans-serif;
        font-size: 14px;
        color: #3c4043;
        line-height: 1.6;
      }

      .wrapper {
        max-width: 600px;
        margin: 48px auto;
        padding: 0 24px;
      }

      .brand {
        font-size: 14px;
        font-weight: 600;
        color: #6750a4;
        margin-bottom: 16px;
      }

      h1 {
        font-size: 24px;
        font-weight: 700;
        color: #1f1f1f;
        margin-bottom: 20px;
      }

      p {
        margin-bottom: 14px;
        color: #3c4043;
      }

      .divider {
        border: none;
        border-top: 1px solid #e8eaed;
        margin: 20px 0;
      }

      .info-table {
        width: 100%;
        border-collapse: collapse;
        margin: 4px 0;
      }

      .info-table tr td {
        padding: 10px 0;
        border-bottom: 1px solid #e8eaed;
        font-size: 14px;
        color: #3c4043;
      }

      .info-table tr:last-child td {
        border-bottom: none;
      }

      .info-table td:first-child {
        color: #80868b;
        width: 140px;
      }

      .info-table td:last-child {
        font-weight: 600;
        color: #1f1f1f;
      }

      .total-row {
        background: #f8f5ff;
        padding: 14px 16px;
        border-radius: 6px;
        margin-top: 16px;
      }

      .total-row td {
        border-bottom: none !important;
        color: #6750a4 !important;
        font-size: 16px;
      }

      .btn {
        display: inline-block;
        margin-top: 24px;
        padding: 10px 22px;
        background: #6750a4;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
      }

      .footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #e8eaed;
        font-size: 12px;
        color: #80868b;
        line-height: 1.8;
      }

      .footer a {
        color: #6750a4;
        text-decoration: none;
      }

  body
    .wrapper
      .brand VTDhub

      h1 Order Confirmation

      p Hello #{username},

      p Thank you for your order! Your order has been successfully placed and is being processed.

      hr.divider

      table.info-table
        tr
          td Order Number
          td #{orderNumber}
        tr
          td Order Date
          td #{createdAt}
        tr
          td Status
          td Pending

      .total-row
        table.info-table(style="margin: 0;")
          tr
            td Total Amount
            td #{totalAmount} VND

      hr.divider

      p
        | We'll notify you when your order is shipped. You can track your order status in your account.

      p Thanks for shopping with us!

      .footer
        | © 2026 VTDhub. All rights reserved.
        br
        a(href="#") Unsubscribe
        |  · 
        a(href="#") Privacy Policy
        |  · 
        a(href="#") Terms of Service