doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Order Update

    style.
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background: #ffffff;
        font-family: Google Sans, Roboto, Arial, sans-serif;
        font-size: 14px;
        color: #3c4043;
        line-height: 1.6;
      }

      .wrapper {
        max-width: 600px;
        margin: 48px auto;
        padding: 0 24px;
      }

      .brand {
        font-size: 14px;
        font-weight: 600;
        color: #6750a4;
        margin-bottom: 16px;
      }

      h1 {
        font-size: 24px;
        font-weight: 700;
        color: #1f1f1f;
        margin-bottom: 20px;
      }

      p {
        margin-bottom: 14px;
        color: #3c4043;
      }

      .divider {
        border: none;
        border-top: 1px solid #e8eaed;
        margin: 20px 0;
      }

      .info-table {
        width: 100%;
        border-collapse: collapse;
        margin: 4px 0;
      }

      .info-table tr td {
        padding: 10px 0;
        border-bottom: 1px solid #e8eaed;
        font-size: 14px;
        color: #3c4043;
      }

      .info-table tr:last-child td {
        border-bottom: none;
      }

      .info-table td:first-child {
        color: #80868b;
        width: 140px;
      }

      .info-table td:last-child {
        font-weight: 600;
        color: #1f1f1f;
      }

      .alert-box {
        background: #fff3cd;
        border-left: 3px solid #ffc107;
        padding: 14px 16px;
        border-radius: 4px;
        margin: 16px 0;
        font-size: 14px;
        color: #3c4043;
      }

      .btn {
        display: inline-block;
        margin-top: 24px;
        padding: 10px 22px;
        background: #6750a4;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
      }

      .footer {
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #e8eaed;
        font-size: 12px;
        color: #80868b;
        line-height: 1.8;
      }

      .footer a {
        color: #6750a4;
        text-decoration: none;
      }

  body
    .wrapper
      .brand VTDhub

      h1 Order Update

      p Hello #{username},

      p Your order has been updated. Some items from a vendor have been cancelled.

      .alert-box
        | ⚠️ #{cancelledItemsCount} item(s) have been cancelled by the vendor.

      hr.divider

      table.info-table
        tr
          td Order Number
          td #{orderNumber}
        tr
          td Updated At
          td #{updatedAt}
        tr
          td Status
          td Pending (Updated)

      hr.divider

      p
        | If you have any questions about this update, please contact our support team.

      p Thanks for your understanding!

      .footer
        | © 2026 VTDhub. All rights reserved.
        br
        a(href="#") Unsubscribe
        |  · 
        a(href="#") Privacy Policy
        |  · 
        a(href="#") Terms of Service